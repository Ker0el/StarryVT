<?xml version="1.0" encoding="utf-8"?>
<!--
    输入框的聚焦「渐变」。

    默认模板的聚焦状态是**硬切**的：底色、边框、下划线用 ObjectAnimationUsingKeyFrames
    直接跳到新颜色（0 秒），鼠标一点就是「啪」一下，很生硬。
    而 Storyboard 动画是**没法做成平滑**的：状态一退，动画立刻回落到基准值，一定是硬切。

    WinUI 里只有 BackgroundTransition 这种**属性过渡**才是双向平滑的，
    它偏偏只能作用在 Background 上（Border 没有 BorderBrushTransition），
    用「外层铺边框色 + 内层留 1px」去仿一圈描边也不行 —— 内层底色是半透明的，
    边框色会从底下透上来，整个框糊成一片主题色（实测踩过）。

    所以这里换个分工：
      · 颜色**全部由代码驱动**（Controls/SmoothField.cs）：在模板根 Grid 里插两层自己的
        元素（底色层 + 1px 焦点环），用 ColorAnimation 渐变；
      · 框架模板自带的聚焦配色**全部抹平**（这份字典，让 Normal / PointerOver / Focused
        三个状态长得一模一样），免得它抢在前头闪一下；
      · 模板本身一个字都不改 —— 光标、输入法、选中、右键菜单、清空按钮全都保持原样。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- 底色：三个状态同一个值（要变的是代码插进来的那层） -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1FFFFFFF" />
            <!-- 边框同上 -->
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#26FFFFFF" />
            <!-- 聚焦时别把下边框加粗到 2px（宽度会跳） -->
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
            <!-- 文字 / 占位文字也别跟着变色（颜色类没有过渡，只会闪） -->
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E4FFFFFF" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E4FFFFFF" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#73FFFFFF" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#73FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TextControlBackground" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#24000000" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#24000000" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#24000000" />
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E4000000" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E4000000" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#73000000" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#73000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
