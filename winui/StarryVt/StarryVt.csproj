<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Starry.Vt.App</RootNamespace>
    <AssemblyName>StarryVt</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 这个版本号进 exe 的 VERSIONINFO（文件属性 / 崩溃日志里认的就是它）。
         ⚠️ 它和 installer.iss 的 AppVersion 是**两套**，发版时两处都要改：
         这三处 + latest.json 的 version 必须一致，不然用户看到 / 崩溃日志里对不上。 -->
    <Version>6.26.0</Version>

    <!-- 程序图标（任务栏 / Alt-Tab / 资源管理器看的是 exe 里嵌的这份，不是文件名）：
         源图 assets\icon-src.png → 生成多尺寸 app.ico（16/24/32/48/64/128/256，都 32bpp） -->
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <!-- 任务管理器 / 文件属性里显示的名字。产品名 = 星译；StarryVT 是仓库与数据目录的内部名字，不动 -->
    <AssemblyTitle>星译</AssemblyTitle>
    <Product>星译</Product>
    <Description>星译 · AI 视频翻译配音</Description>
    <Company>星空</Company>
    <Copyright>Copyright © 2026 星空</Copyright>

    <!-- 免安装：不打包 MSIX，Windows App SDK 自带，省得用户还要装运行时 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!-- 拖放要用 OLE 的 IDropTarget（COM 接口），没有这个开关 .NET 8 会把内建 COM 互操作关掉 -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!-- WinUI 3 自带的裁剪不安全，关掉 -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!--
      不引 Microsoft.WindowsAppSDK 那个大包 —— 它会把 AI(onnxruntime+DirectML 38MB)、
      ML、Search、Widgets 全部拖进来，这个工具一个都用不到。只要 WinUI 本身 + 运行时。
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    ⚠️ `dotnet publish` **不会**把编译后的 XAML 和资源索引带过去：
    App.xbf / MainWindow.xbf / <程序名>.pri 三个文件会落在 build 输出里、不进 publish 目录。
    少了它们的发布版一启动就抛「XAML parsing failed」，而且报错完全不提缺文件。
    这里 publish 完之后补一次拷贝。

    ⚠️ 子目录里的 xbf 也要带上（Pages/、Controls/）—— `*.xbf` **不递归**，
       只拷顶层的话，切到任意一个页面就抛 XAML parsing failed（2026-10-14 实测）。
  -->
  <Target Name="CopyXamlArtifactsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_XamlArtifact Include="$(TargetDir)*.xbf" />
      <_XamlArtifact Include="$(TargetDir)**\*.xbf" />
      <_XamlArtifact Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_XamlArtifact)" DestinationFiles="@(_XamlArtifact->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
