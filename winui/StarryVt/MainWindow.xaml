<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Starry.Vt.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="星译">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 品牌层：星空。底下压的是系统真材料（Mica / 亚克力），
             这层只负责"是星空的"，强度可以在设置里调（0% 就是纯材料）。 -->
        <!-- 主视觉：整屏背景图（照 DUM 的主页）。0% 强度就是纯系统材料。 -->
        <Grid x:Name="BgLayer" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.95">
            <!-- 动图壁纸（mp4）：和下面那张静态图二选一显示，见 MainWindow.LoadWallpaperAsync -->
            <MediaPlayerElement x:Name="HeroVideo" Stretch="UniformToFill" Visibility="Collapsed"
                                AreTransportControlsEnabled="False" />
            <!-- 窗口缩放/最大化时盖住视频表面的绿帧、黑帧；内容是当前壁纸的一帧 -->
            <Image x:Name="WallPoster" Stretch="UniformToFill" Visibility="Collapsed" />
            <Image x:Name="HeroImage" Source="ms-appx:///Assets/hero.png" Stretch="UniformToFill" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{ThemeResource ScrimStartColor}" Offset="0" />
                        <GradientStop Color="{ThemeResource ScrimMidColor}" Offset="0.42" />
                        <GradientStop Color="{ThemeResource ScrimEndColor}" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Canvas x:Name="StarCanvas" Opacity="0.35" />
        </Grid>

        <!-- 顶部压暗一条：标题和图标才看得清 -->
        <Border Grid.RowSpan="2" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{ThemeResource TopBandBrushColor}" Offset="0" />
                    <GradientStop Color="{ThemeResource TopBandEndColor}" Offset="0.22" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- 自绘标题栏：内容顶到窗口边，玻璃连成一片。右边留 140 给系统按钮 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Margin="0,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="9" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="星译" FontSize="13.5" VerticalAlignment="Center" />
                <!-- 版本号不写死：后端 ready 后由 MainWindow 用 Backend.Version 填
                     （以前这里硬编码 v6.10，更新到 6.12 后标题栏还显示 6.10） -->
                <TextBlock x:Name="TitleVersion" Text="" FontSize="13.5" Opacity="0.55" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleSlogan" Text="翻译，从未如此简单" FontSize="12.5" Opacity="0.4"
                           VerticalAlignment="Center" Margin="6,1,0,0" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="RootNav" Grid.Row="1"
                        Background="Transparent"
                        PaneDisplayMode="Left"
                        IsPaneToggleButtonVisible="False"
                        IsPaneOpen="True"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        OpenPaneLength="252"
                        SelectionChanged="RootNav_SelectionChanged">
            <NavigationView.Resources>
                <!-- 内容区默认自带一层半透明底色，会把星空整个压暗 —— 抹掉，
                     让内容和玻璃/星空直接贴合（卡片自己有不透明度的填充） -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <!-- 导航项加高：默认 40 太矮，用户说不太好点到 -->
                <x:Double x:Key="NavigationViewItemOnLeftMinHeight">54</x:Double>
                <x:Double x:Key="NavigationViewItemMinHeight">54</x:Double>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="主页" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="本地翻译" Tag="local">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="在线翻译" Tag="online">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 只在设置里勾了「检查和编辑字幕」时显示（见 SetSubtitleNavVisible） -->
                <NavigationViewItem x:Name="SubtitleNav" Content="字幕检查" Tag="subtitle"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <!-- 关于排在设置上面 -->
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- 内容区包一层：上面那条是「发现新版本」提示条（启动时后端自动查到才出现）。
                 不用 ContentDialog 弹窗 —— 启动就弹窗太打断人，挂条横幅让人自己决定什么时候更。 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="UpdateBar" Grid.Row="0" Visibility="Collapsed"
                        Margin="42,18,42,0" Padding="16,12" CornerRadius="8"
                        Background="{ThemeResource PanelBrush}"
                        BorderBrush="{ThemeResource PanelStrokeBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE895;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="UpdateNotes" FontSize="12.5" Opacity="0.7" TextWrapping="Wrap"
                                       MaxLines="2" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button x:Name="UpdateGoBtn" Grid.Column="2" Content="立即更新" Click="UpdateGo_Click" />
                        <HyperlinkButton x:Name="UpdateManualBtn" Grid.Column="3" Content="手动下载"
                                         Visibility="Collapsed" Click="UpdateManual_Click"
                                         ToolTipService.ToolTip="打开 GitHub Releases 页面" />
                        <Button x:Name="UpdateLaterBtn" Grid.Column="4" Content="以后再说" Click="UpdateLater_Click" />
                    </Grid>
                </Border>

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>

        <!-- 模态遮罩：赞赏码弹出来时用。轻磨砂 + 居中，点任意地方关掉（Esc 也行）。
             要「稍微模糊」所以 TintOpacity 压得很低 —— 亚克力本身的模糊半径改不了，
             让它显得轻只能靠降低那层白雾。 -->
        <!-- ⚠️⚠️ Translation 的 Z=28 是**必须的**：卡片加了主题阴影之后都在 Z=20 那一层，
             遮罩不抬高就会被卡片盖住（磨砂只罩得住背景，卡片照样亮着）。
             28 要**大于卡片的 20**、小于里面那张赞赏码的 32。 -->
        <Grid x:Name="ModalScrim" Grid.RowSpan="2" Visibility="Collapsed"
              Tapped="ModalScrim_Tapped" Translation="0,0,28">
            <!-- 磨砂层再叠一层半透明：亚克力的模糊半径是系统定死的（改不了），
                 想「只模糊一点点」就让它跟清晰的内容各占一半。卡片本身不透明，不受影响。 -->
            <Grid x:Name="ScrimBlur" Opacity="0.42">
                <Grid.Background>
                    <AcrylicBrush TintColor="#0B1020" TintOpacity="0.06"
                                  TintLuminosityOpacity="0.06" FallbackColor="#590B1020" />
                </Grid.Background>
            </Grid>
            <Border x:Name="QrCard" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="8" Background="White" Padding="10"
                    BorderBrush="#33000000" BorderThickness="1"
                    Translation="0,0,32">
                <StackPanel Spacing="8">
                    <Image Source="ms-appx:///Assets/zanshang.png" Width="320" Height="320" />
                    <TextBlock Text="感谢您的支持！我们会做的更好！" FontSize="14.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="Black" />
                    <TextBlock Text="点任意位置关闭" FontSize="12.5" Opacity="0.55"
                               HorizontalAlignment="Center" Foreground="Black" />
                </StackPanel>
            </Border>

            <!-- 微信浮层：二维码 + 可复制的微信号。和赞赏码 / 感谢 / 术语库共用同一层遮罩，
                 同一时刻只开一张；没有关闭按钮，点空白或按 Esc 关掉，进出都是渐隐渐现。 -->
            <Border x:Name="WxCard" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="12" Background="{ThemeResource PanelBrush}"
                    BorderBrush="{ThemeResource PanelStrokeBrush}" BorderThickness="1"
                    Translation="0,0,32" Tapped="WxCard_Tapped">
                <StackPanel Spacing="12" Width="280">
                    <!-- 二维码保持白底，深色卡片上才扫得出来 -->
                    <Border Background="White" CornerRadius="10" Padding="8"
                            HorizontalAlignment="Center">
                        <Image Source="ms-appx:///Assets/vx.png" Width="260" Height="260" />
                    </Border>
                    <TextBlock Text="扫码添加微信" FontSize="13.5" Opacity="0.65"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="点任意位置关闭" FontSize="12" Opacity="0.45"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <!-- 字幕样式放大预览：设置页点预览图弹它。和微信/感谢共用遮罩，
                 没有关闭按钮，点画面任何地方或按 Esc 都关掉，进出都是渐隐渐现。
                 卡片本身透明、无边框：避免大图外面再套一层「黑框」。 -->
            <Border x:Name="PreviewCard" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="Transparent" Padding="0" BorderThickness="0"
                    Translation="0,0,32">
                <StackPanel Spacing="8">
                    <Viewbox Stretch="Uniform" MaxWidth="1600" MaxHeight="900">
                        <Image x:Name="PreviewImage" Width="1920" Height="1080" Stretch="Fill" />
                    </Viewbox>
                    <TextBlock Text="点任意位置关闭" FontSize="12" Opacity="0.55"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 「感谢」浮层（设置页那颗按钮弹它）：渐隐渐现、**点空白关掉、没有按钮**
                 （用户 2026-10-16 定）。和赞赏码共用这一层遮罩 —— 同一时刻只开一张卡。
                 卡片内部的点击不关它（里面还有链接要点，见 ThanksCard_Tapped）。 -->
            <Border x:Name="ThanksCard" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="14" Padding="26,22,22,22" MaxWidth="560" MaxHeight="560"
                    Background="{ThemeResource PanelBrush}"
                    BorderBrush="{ThemeResource PanelStrokeBrush}" BorderThickness="1"
                    Translation="0,0,30" Tapped="ThanksCard_Tapped">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel x:Name="ThanksList" Spacing="13" />
                </ScrollViewer>
            </Border>

            <!-- 「术语库」浮层（设置页「查看术语库…」弹它）：列本机术语库里有什么、能清空。
                 和「感谢」同一套：渐隐渐现、**点空白关掉、没有关闭按钮**、卡片内点击不关
                 （里面的按钮还要能按）。内容**每次打开都重取** —— 引擎随时会学到新词条。 -->
            <Border x:Name="KnowledgeCard" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="14" Padding="26,22,22,22" MaxHeight="620"
                    Background="{ThemeResource ModalCardBrush}"
                    BorderBrush="{ThemeResource PanelStrokeBrush}" BorderThickness="1"
                    Translation="0,0,30" Tapped="KnowledgeCard_Tapped">
                <Grid RowSpacing="12" Width="580">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="5">
                        <TextBlock Text="术语库" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="KbSummary" FontSize="12.5" Opacity="0.75"
                                   TextWrapping="Wrap" Text="正在读…" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,10,0" MinHeight="140">
                        <StackPanel x:Name="KbList" Spacing="14" />
                    </ScrollViewer>

                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="KbRefreshBtn" Grid.Column="0" Content="刷新" Click="KbRefresh_Click" />
                        <Button x:Name="KbClearBtn" Grid.Column="1" Content="清空学到的术语" Click="KbClear_Click" />
                        <TextBlock x:Name="KbStatus" Grid.Column="2" FontSize="12.5" Opacity="0.7"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
