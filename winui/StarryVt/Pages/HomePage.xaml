<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Starry.Vt.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fakes="using:Starry.Vt.App.Fakes"
    xmlns:ctl="using:Starry.Vt.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button"
               BasedOn="{StaticResource GlassButtonStyle}">
            <Setter Property="MinWidth" Value="196" />
        </Style>
    </Page.Resources>

    <Grid Padding="42,24,42,20" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="5">
            <TextBlock Text="开始使用" FontSize="38" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" Text="第一次用：点右下角「一键初始化」，我帮你一件件配好"
                       FontSize="14" Opacity="0.78" />
        </StackPanel>

        <!-- 初始化清单（照 DUM 的左悬浮卡） -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="760" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" VerticalAlignment="Top"
                    CornerRadius="8" Background="{ThemeResource PanelBrush}"
                    BorderBrush="{ThemeResource PanelStrokeBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="18,15,14,13">
                        <TextBlock Text="环境初始化 ✦" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <!-- 「重新检测」跑完一键初始化才出现：还没查过的时候它只会让人以为
                             「有个东西在报错、得点一下」，其实什么都还没查（用户 2026-10-13 定） -->
                        <Button x:Name="RecheckBtn" Visibility="Collapsed"
                                Padding="14,7" CornerRadius="6" HorizontalAlignment="Right"
                                Background="{ThemeResource PanelSubtleBrush}" BorderThickness="0"
                                Click="Recheck_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="13.5" />
                                <TextBlock Text="重新检测" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 总进度：一键初始化跑起来才出现 -->
                    <ProgressBar x:Name="RunBar" Grid.Row="1" Margin="18,0,18,10"
                                 Minimum="0" Maximum="1" Value="0" Visibility="Collapsed" />

                    <!-- 还没开始检查时这儿说一句；清单是点「一键初始化」后一条条长出来的 -->
                    <TextBlock x:Name="EmptyHint" Grid.Row="2" Margin="22,4,22,22" FontSize="13.5"
                               Opacity="0.62" TextWrapping="Wrap" VerticalAlignment="Top"
                               Text="点右下角「一键初始化」，我一件件办好（一般五六项）" />

                    <ListView x:Name="Steps" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="False"
                              Padding="12,0,12,12">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="fakes:SetupStep">
                                <Grid ColumnSpacing="12" Padding="10,9" CornerRadius="6"
                                      Background="{x:Bind RowBrush, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 三种状态共用左边这一格：转圈 / 对勾感叹号 / 空心点 -->
                                    <ProgressRing Grid.Column="0" Width="18" Height="18"
                                                  IsActive="{x:Bind IsDoing, Mode=OneWay}"
                                                  Visibility="{x:Bind RingVisibility, Mode=OneWay}" />
                                    <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph, Mode=OneWay}"
                                              FontSize="15" VerticalAlignment="Center"
                                              Foreground="{x:Bind IconBrush, Mode=OneWay}"
                                              Visibility="{x:Bind IconVisibility, Mode=OneWay}"
                                              RenderTransformOrigin="0.5,0.5"
                                              ctl:PopWhenShown.On="True">
                                        <FontIcon.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </FontIcon.RenderTransform>
                                    </FontIcon>
                                    <Ellipse Grid.Column="0" Width="11" Height="11"
                                             StrokeThickness="1.6" Stroke="#59FFFFFF"
                                             VerticalAlignment="Center" HorizontalAlignment="Center"
                                             Visibility="{x:Bind DotVisibility, Mode=OneWay}" />

                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontSize="15" />
                                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" FontSize="12.5" Opacity="0.62"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="{x:Bind FixLabel}"
                                            Visibility="{x:Bind HasAction}" FontSize="13.5"
                                            Padding="10,4" VerticalAlignment="Center"
                                            Background="{ThemeResource PanelSubtleBrush}" BorderThickness="0"
                                            Click="StepAction_Click" Tag="{x:Bind Fix}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- 右下角：一开始只有一个醒目的「一键初始化」（主题色玻璃 + 呼吸的光圈），跑完变成「进入本地翻译」 -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Spacing="10" Margin="0,0,0,42">
            <!-- 装到哪：**只告知，不给换**（2026-10-16 用户定）。
                 初始化这一屏不放换盘入口 —— 要换去设置页（那儿改之前会弹确认），
                 所以这里只给一个「去设置」的链接把人送过去：想改的人找得到路，
                 首页又不会有「误点换盘」的坑（中途换 = 这一趟仍下进老目录，白下一份）。
                 这行字留着，是因为「引擎和模型要占约 15 GB、具体落在哪块盘」
                 是开工前就该知道的事（游戏本的 C 盘很容易被占满）。
                 路径**必须取实际生效值**（finesub_home_actual），见 LoadHomeRowAsync。
                 只在**还没配好**时出现（配好之后这行就收起了）。 -->
            <StackPanel x:Name="HomeRow" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right">
                <TextBlock x:Name="HomeLabel" FontSize="12.5" Opacity="0.62" VerticalAlignment="Center" />
                <HyperlinkButton x:Name="HomeGoSettings" Content="去设置" FontSize="12.5"
                                 Padding="4,2" VerticalAlignment="Center" Click="GoSettings_Click" />
            </StackPanel>

            <Grid>
                <!-- 呼吸光：一层柔和的径向渐变（描边那种硬圈很难看，用户否过）。
                     颜色在代码里按主题色填，别写死。 -->
                <Border x:Name="SetupGlow" Margin="-16" CornerRadius="22" Opacity="0"
                        IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5"
                                             RadiusX="0.62" RadiusY="0.62">
                            <GradientStop Offset="0.35" Color="#59FF6FB5" />
                            <GradientStop Offset="0.75" Color="#26FF6FB5" />
                            <GradientStop Offset="1" Color="#00FF6FB5" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="GlowScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                </Border>

                <Button x:Name="SetupButton" Click="Setup_Click"
                        Style="{StaticResource PrimaryGlassButtonStyle}"
                        MinWidth="228">
                    <StackPanel Orientation="Horizontal" Spacing="11">
                        <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False"
                                      Visibility="Collapsed" />
                        <FontIcon x:Name="SetupIcon" Glyph="&#xE896;" FontSize="16" />
                        <TextBlock x:Name="SetupLabel" Text="一键初始化" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="2" HorizontalAlignment="Center" FontSize="12.5" Opacity="0.55"
                   x:Name="FootHint" Text="首次使用要先完成初始化" />
    </Grid>
</Page>
