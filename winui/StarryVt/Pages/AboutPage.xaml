<?xml version="1.0" encoding="utf-8"?>
<!--
  关于页 —— hero 版式：内容居中浮在壁纸之上，从 logo 到版权行**逐块错开淡入**
  （参考 DreamTranslatePO 的 about 页；它的 resources.pri 里有
   Storyboard / TranslateTransform / ScaleTransform / BlurEffect，
   即「淡入 + 位移 + 模糊收清」，这里用【位移 + 缩放】表达同样的收上来，见 Motion.HeroIn）。

  ⚠️ 这一页**不套卡片**（别的页都是卡片）：参考程序就是直接浮在图上的。
  代价是亮壁纸上白字会糊 —— 所以中间压了一条纵向的暗渐变，
  它只负责让字读得清，肉眼不该看出"这里有个框"。
-->
<Page
    x:Class="Starry.Vt.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- ⚠️ RequestedTheme="Dark" 是**故意**钉死的：这一页从头到尾都是"深色蒙版上的 hero"
         （下面那条黑渐变是写死的，不跟主题走）。不钉的话，浅色主题下按钮用的
         PanelSubtleBrush 会变成 #14000000（深色半透明）、文字默认前景也会变成深色 ——
         深底 + 深字，整页读不了。钉死之后子树里的 ThemeResource 全部按深色解析。 -->
    <Grid RequestedTheme="Dark">
        <!--
          ⚠️ 这里本来有一层「背景模糊收清」（参考程序 about 页入场那层，用
             CompositionBackdropBrush + Win2D 高斯模糊做的）。**已经去掉了**，两个原因：
               ① CompositionBackdropBrush 抓不到视频壁纸 —— MediaPlayerElement 是独立交换链，
                  它抓出来的只有深色蒙版和星点，于是整页变成一片深蓝星空，
                  用户一眼就看出"背景不对、透不过壁纸"
               ② 它每帧都要重抓一次背后，开销一直在
          这一页要的是**透明背景、能透出壁纸**，所以宁可不要那层效果。
          入场动效保留：整页收拢 + 擦开 + 文字错开（都在页面自己身上，不碰背景）。 -->

        <!-- 中间压暗：亮壁纸上白字也读得清。上下都淡出，不留边界 -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0.00" />
                    <GradientStop Color="#59000000" Offset="0.30" />
                    <GradientStop Color="#6B000000" Offset="0.50" />
                    <GradientStop Color="#59000000" Offset="0.70" />
                    <GradientStop Color="#00000000" Offset="1.00" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <ScrollViewer x:Name="HeroScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                      BringIntoViewOnFocusChange="False">
            <!-- ⚠️ 光给 StackPanel 写 VerticalAlignment="Center" 是没用的：ScrollViewer 的内容
                 会被排在自己的高度上、贴在顶部。要真正竖直居中，得让外层 Grid 至少有一个
                 视口那么高。
                 ⚠️⚠️ 千万别用
                 `MinHeight="{x:Bind HeroScroll.ViewportHeight, Mode=OneWay}"` ——
                 那是条在**布局过程中回写**的活绑定，实测直接把程序打崩：
                 事件日志 Microsoft.UI.Xaml.dll / 0xc000027b（XAML 未处理异常），
                 窗口整个消失、没有任何提示。
                 → 结论：**干脆不撑**，靠上下 padding 让观感居中，够用且零风险。 -->
            <Grid x:Name="HeroHost">
                <StackPanel x:Name="Hero" HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="830" Padding="28,36,28,40">

                <Image x:Name="BLogo" Source="ms-appx:///Assets/app-icon.png"
                       Width="76" Height="76" HorizontalAlignment="Center" />

                <TextBlock x:Name="BTitle" Text="星译"
                           FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Margin="0,14,0,0" />

                <TextBlock x:Name="BEasy" Text="Easy Translate"
                           FontSize="16" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.72" />

                <TextBlock x:Name="BSlogan" Text="翻译，从未如此简单"
                           FontSize="15" HorizontalAlignment="Center" Margin="0,8,0,0"
                           Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                <!-- 分割线用**半透明白**，不用主题的 DividerStrokeColorDefaultBrush ——
                     那个色在壁纸上几乎看不见（第一版就是这么瞎的，截图上完全找不到线）。 -->
                <Border x:Name="BRule1" Height="1" Width="300" Margin="0,22,0,20"
                        HorizontalAlignment="Center" Background="White" Opacity="0.25" />

                <!-- 版本 / 出品：一行一句话，别堆成表 -->
                <!-- ⚠️ 这里原来还有一行「免费版后续不再更新」—— 2026-10-16 去掉了：
                     软件名不再叫「免费版」，而且每发一版免费更新，那句话就自己打自己脸一次。 -->
                <!-- ⚠️ 2026-10-16 这里还有过一行「赞助 199 元：一次远程部署协助 + …」——
                     2026-10-17 用户让删掉，**并且把它的彩虹渐变搬到了下面那句免费声明上**。
                       · 渐变当 Foreground，字由 WinUI 自己画、不重采样，和其他几行一样锐利。
                       · ⚠️ 停靠点铺到 [0,1] **之外**、颜色按格周期排，是"整体左移一格还能无缝"的
                         前提（原来那行留下的写法，照抄）。试过的两条会"发粗/发软"的路子别再走：
                         ① 拿文字当面具去裁合成层渐变（抗锯齿丢了）② 合成层的渐变刷（不动）。
                       · 那行原来要求「一行显示不换行」才把整栏放到 830；现在最长的一句是
                         版权行和这句免费声明，都短得多，830 只是没动（MaxWidth 只封顶，无害）。 -->
                <StackPanel x:Name="BMeta" Spacing="6">
                    <TextBlock x:Name="BVersion" Text="当前版本" FontSize="13.5"
                               HorizontalAlignment="Center" Opacity="0.9" />
                    <TextBlock Text="星空 出品"
                               FontSize="13.5" HorizontalAlignment="Center" Opacity="0.62"
                               TextWrapping="Wrap" TextAlignment="Center" />
                    <!-- 这句是这一页的"卖点行"，所以比旁边两行亮一档、大 0.5 号，并穿彩虹渐变 -->
                    <TextBlock Text="软件完全免费使用，所有功能都开放"
                               FontSize="14" HorizontalAlignment="Center" Opacity="0.92"
                               TextWrapping="NoWrap" TextAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFF9E6B" Offset="-0.1667" />
                                <GradientStop Color="#FF7AD7FF" Offset="0.0000" />
                                <GradientStop Color="#FF9E8CFF" Offset="0.1667" />
                                <GradientStop Color="#FFFF8AD8" Offset="0.3333" />
                                <GradientStop Color="#FFFFC46B" Offset="0.5000" />
                                <GradientStop Color="#FF7DFFC2" Offset="0.6667" />
                                <GradientStop Color="#FFFF9E6B" Offset="0.8333" />
                                <GradientStop Color="#FF7AD7FF" Offset="1.0000" />
                                <GradientStop Color="#FF9E8CFF" Offset="1.1667" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>

                <!-- ⚠️ 这条分隔线是我 2026-10-17 删赞助那行时**误删过**的（编译报「BRule2
                     不存在」才发现）。它是 meta 和按钮之间那条，改动这块时别跟着一起删。 -->
                <Border x:Name="BRule2" Height="1" Width="300" Margin="0,20,0,20"
                        HorizontalAlignment="Center" Background="White" Opacity="0.25" />

                <!-- 三个胶囊按钮：微信（复制）/ B 站 / 赞赏码。
                     赞赏码那颗用二维码缩略图而不是图标 —— 一眼就知道是"扫码赏"，
                     不用去猜哪个字形是什么意思。 -->
                <StackPanel x:Name="BBtns" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button x:Name="BWx" Click="ShowWx_Click" CornerRadius="17" Padding="16,7"
                            BorderThickness="0" Background="{ThemeResource PanelSubtleBrush}"
                            ToolTipService.ToolTip="点一下看微信二维码">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <!-- 微信官方 logo（Simple Icons 的 wechat 路径，24×24）。
                                 和 B 站那颗一样用 Viewbox + Path，别用 PathIcon（大坐标路径会画空）。 -->
                            <Viewbox Width="16" Height="16">
                                <Path Fill="White"
                                      Data="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 0 0 .167-.054l1.903-1.114a.864.864 0 0 1 .717-.098 10.16 10.16 0 0 0 2.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178A1.17 1.17 0 0 1 4.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178 1.17 1.17 0 0 1-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.28 1.786-1.72 1.428-2.687 3.72-1.78 6.22.942 2.453 3.666 4.229 6.884 4.229.826 0 1.622-.12 2.361-.336a.722.722 0 0 1 .598.082l1.584.926a.272.272 0 0 0 .14.047c.134 0 .24-.111.24-.247 0-.06-.023-.12-.038-.177l-.327-1.233a.582.582 0 0 1-.023-.156.49.49 0 0 1 .201-.398C23.024 18.48 24 16.82 24 14.98c0-3.21-2.931-5.837-6.656-6.088V8.89c-.135-.01-.27-.027-.407-.03zm-2.53 3.274c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.97-.982zm4.844 0c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.969-.982z" />
                            </Viewbox>
                            <TextBlock Text="微信" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BBili" Click="Bili_Click" CornerRadius="17" Padding="16,7"
                            BorderThickness="0" Background="{ThemeResource PanelSubtleBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <!-- B 站官方那个 mark（圆角电视 + 两根天线 + 两只眼睛）。
                                 用户 2026-10-14 要求用"和参考软件一样的那种 B 站图标"，
                                 不要通用链接字形。路径是 512×512 的官方图形。
                                 ⚠️ 用 Viewbox + Path，**不要用 PathIcon** ——
                                    实测 PathIcon 对这个大坐标路径什么都不画（没有报错，就是空）。
                                 Viewbox 按自然尺寸画完再缩到 16，稳。 -->
                            <Viewbox Width="16" Height="16">
                                <Path Fill="White"
                                      Data="M488.6 104.1c16.7 18.1 24.4 39.7 23.3 65.7v202.4c-.4 26.4-9.2 48.1-26.5 65.1c-17.2 17-39.1 25.9-65.5 26.7H92.02c-26.45-.8-48.21-9.8-65.28-27.2C9.682 419.4.767 396.5 0 368.2V169.8c.767-26 9.682-47.6 26.74-65.7C43.81 87.75 65.57 78.77 92.02 78h29.38L96.05 52.19c-5.75-5.73-8.63-13-8.63-21.79c0-8.8 2.88-16.06 8.63-21.797C101.8 2.868 109.1 0 117.9 0q13.2 0 21.9 8.603L213.1 78h88l74.5-69.397C381.7 2.868 389.2 0 398 0q13.2 0 21.9 8.603c5.7 5.737 8.6 12.997 8.6 21.797c0 8.79-2.9 16.06-8.6 21.79L394.6 78h29.3c26.4.77 48 9.75 64.7 26.1m-38.8 69.7c-.4-9.6-3.7-17.4-10.7-23.5c-5.2-6.1-14-9.4-22.7-9.8H96.05c-9.59.4-17.45 3.7-23.58 9.8c-6.14 6.1-9.4 13.9-9.78 23.5v194.4c0 9.2 3.26 17 9.78 23.5s14.38 9.8 23.58 9.8H416.4c9.2 0 17-3.3 23.3-9.8s9.7-14.3 10.1-23.5zm-264.3 42.7c6.3 6.3 9.7 14.1 10.1 23.2V273c-.4 9.2-3.7 16.9-9.8 23.2c-6.2 6.3-14 9.5-23.6 9.5s-17.5-3.2-23.6-9.5s-9.4-14-9.8-23.2v-33.3c.4-9.1 3.8-16.9 10.1-23.2s13.2-9.6 23.3-10c9.2.4 17 3.7 23.3 10m191.5 0c6.3 6.3 9.7 14.1 10.1 23.2V273c-.4 9.2-3.7 16.9-9.8 23.2s-14 9.5-23.6 9.5s-17.4-3.2-23.6-9.5c-7-6.3-9.4-14-9.7-23.2v-33.3c.3-9.1 3.7-16.9 10-23.2s14.1-9.6 23.3-10c9.2.4 17 3.7 23.3 10" />
                            </Viewbox>
                            <TextBlock Text="B 站" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BQr" Click="ShowQr_Click" CornerRadius="17" Padding="12,5"
                            BorderThickness="0" Background="{ThemeResource PanelSubtleBrush}"
                            ToolTipService.ToolTip="点一下放大">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Border CornerRadius="4" Background="White" Padding="2">
                                <Image Source="ms-appx:///Assets/zanshang.png" Width="20" Height="20" />
                            </Border>
                            <TextBlock Text="赞赏码" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 版权 + 壁纸来源（参考程序那个位置放的是画师署名，同一个意思）
                     ⚠️ 2026-10-17 用户要求改成三行：默认视频壁纸的作者**单独占一行、可点**
                     （链到原片），在线图源挪到第三行。
                     这里用 HyperlinkButton 而不是 RichTextBlock 里的 Hyperlink ——
                     感谢页那颗就是 HyperlinkButton，已经验证过能开浏览器。
                     ⚠️ 那块**不再是一个 TextBlock**，代码里点 BCredit.Text 的地方要跟着改
                     （见 AboutPage.xaml.cs 的 BuildCredit）。
                     ⚠️⚠️ 2026-10-17 二次调整：第三行**不再列具体域名**（用户要求
                     「不要写具体的网址」）→ 那句从「代码现算」变成写死的一句，
                     `Wallpaper.SourceHosts()` 和 `BuildCredit()` 一起删掉了。
                     图源清单本身还在 `Wallpaper.cs` 的 `ImageSources` / `VideoSources` 里
                     （那是运行需要的），只是不再显示给用户。 -->
                <StackPanel x:Name="BCredit" Margin="0,26,0,0" Spacing="0"
                            HorizontalAlignment="Center">
                    <TextBlock x:Name="BCCopy" FontSize="12" LineHeight="19" Opacity="0.48"
                               TextAlignment="Center" HorizontalAlignment="Center"
                               Text="星译 版权归星空所有 Copyright © 2026 星空" />
                    <!-- 作者署名比别处亮一档（0.72 对 0.48）：它是要点的，太暗就不像能点 -->
                    <HyperlinkButton x:Name="BWallpaperBy" Padding="0" MinHeight="0" FontSize="12"
                                     Opacity="0.72" HorizontalAlignment="Center"
                                     Content="视频背景来自 B站 星雨布丁 channel"
                                     Click="WallpaperBy_Click" />
                    <TextBlock x:Name="BCreditSources" FontSize="12" LineHeight="19" Opacity="0.48"
                               TextAlignment="Center" HorizontalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="640"
                               Text="其他背景图来自公开图源" />
                </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
