<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Starry.Vt.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctl="using:Starry.Vt.App.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 一行设置：左边标题+说明，右边控件（和 WinUI 的 SettingsCard 一个观感） -->
        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowDescStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="RowDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="GroupTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="16,14,16,10" />
        </Style>
    </Page.Resources>

    <Grid Padding="26,10,26,22" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="7">
            <TextBlock Text="设置" FontSize="32" FontWeight="SemiBold" />
            <TextBlock x:Name="SaveState" Text="改动会自动保存" FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 用 ScrollView（基于 InteractionTracker，滚动走合成器动画）而不是旧的 ScrollViewer：
             鼠标滚轮更顺，也不容易和视频壁纸的独立交换链打架。
             ⚠️ 点编辑框再点空白时，WinUI 会把焦点丢给 ScrollView 里第一个可聚焦控件
             （顶部 API Key），页面就被拽回顶部。用 FocusSink + PointerPressed 接住空白点击。 -->
        <ScrollView x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden"
                    VerticalAnchorRatio="0.5"
                    AutomationProperties.AutomationId="PageScroll">
            <StackPanel x:Name="SettingsContent" Spacing="12" MaxWidth="1120"
                        HorizontalAlignment="Left" Padding="0,0,4,0">

                <!-- ================= API Key ================= -->
                <Border Style="{StaticResource CardStyle}" Translation="0,0,20"
                        Background="{ThemeResource PanelBrush}"
                        BorderBrush="{ThemeResource PanelStrokeBrush}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="API Key" Style="{StaticResource GroupTitleStyle}" />
                        <TextBlock Text="只需填下面两个 Key，其他设置保持默认就能用。填完自动保存。"
                                   FontSize="12.5" Opacity="0.65" Margin="18,4,18,12" TextWrapping="Wrap" />
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MiMo API Key" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="配音用 · 小米 MiMo 官方 API（mimo-v2.5-tts）· 目前限时免费"
                                           Style="{StaticResource RowDescStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="MimoHint" FontSize="12.5" Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <Grid Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 默认打星号：投屏、录屏、旁边有人时 key 不该明晃晃摆着 -->
                                <!-- PasswordBox 才是能打星号的那个（TextBox 在 WinUI 里没有 PasswordRevealMode） -->
                                <!-- 没有「测试」按钮：填完停一下、或者点到别处，自己就测（见 Key_Changed / Key_LostFocus） -->
                                <PasswordBox x:Name="MimoBox" Grid.Column="0" PlaceholderText="粘贴你自己的 MiMo API Key"
                                             PasswordRevealMode="Hidden" PasswordChar="*"
                                             PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                                <Button x:Name="MimoEye" Grid.Column="1" Content="显示" Padding="10,5"
                                        Click="ToggleMimo_Click"
                                        ToolTipService.ToolTip="点一下看一眼，再点一下变回星号" />
                                <HyperlinkButton x:Name="MimoApply" Grid.Column="2" Content="去申请 ↗" Padding="8,4"
                                                 Click="Apply_Click" />
                            </Grid>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DeepSeek API Key" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="翻译用 · DeepSeek 官方 API（deepseek-flash，备用 deepseek-v4-pro）· 按量计费"
                                           Style="{StaticResource RowDescStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="DeepHint" FontSize="12.5" Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <Grid Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- PasswordBox 才是能打星号的那个（TextBox 在 WinUI 里没有 PasswordRevealMode） -->
                                <PasswordBox x:Name="DeepBox" Grid.Column="0" PlaceholderText="粘贴你自己的 DeepSeek API Key"
                                             PasswordRevealMode="Hidden" PasswordChar="*"
                                             PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                                <Button x:Name="DeepEye" Grid.Column="1" Content="显示" Padding="10,5"
                                        Click="ToggleDeep_Click"
                                        ToolTipService.ToolTip="点一下看一眼，再点一下变回星号" />
                                <HyperlinkButton x:Name="DeepApply" Grid.Column="2" Content="去申请 ↗" Padding="8,4"
                                                 Click="Apply_Click" />
                            </Grid>
                        </Grid>

                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DeepSeek 额度" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="当前账户余额，翻译会从这里面扣"
                                           Style="{StaticResource RowDescStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock x:Name="DeepBalanceText" Text="—" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button x:Name="DeepBalanceRefresh" Content="刷新" Padding="12,5"
                                        Click="DeepBalanceRefresh_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= 配音 ================= -->
                <Border Style="{StaticResource CardStyle}" Translation="0,0,20"
                        Background="{ThemeResource PanelBrush}"
                        BorderBrush="{ThemeResource PanelStrokeBrush}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="翻译与配音" Style="{StaticResource GroupTitleStyle}" />
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="默认输出" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="所有任务统一按这里配置"
                                           Style="{StaticResource RowDescStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ctl:GlassSelect x:Name="DefaultOutputBox" Grid.Column="1" MinWidth="220" />
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="翻译方向" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="外语译成中文，或中文译成英语"
                                           Style="{StaticResource RowDescStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <ctl:GlassSelect x:Name="LangBox" MinWidth="220" />
                                <TextBlock x:Name="LangHint" Text="英文配音建议用 Mia / Chloe / Milo / Dean"
                                           FontSize="12" Opacity="0.6" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="默认配音音色" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="所有任务统一用这个音色"
                                           Style="{StaticResource RowDescStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <Grid x:Name="VoiceControls" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ctl:GlassSelect x:Name="VoiceBox" Grid.Column="0" MinWidth="220" />
                                    <Button x:Name="PreviewVoiceButton" Grid.Column="1" Content="试听"
                                            ToolTipService.ToolTip="合成一句样音，听听这个音色"
                                            Click="PreviewVoice_Click" />
                                </Grid>
                                <TextBlock x:Name="VoiceOffHint" Text="已启用原声克隆，这个音色不生效"
                                           FontSize="12" Opacity="0.6" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="自动使用视频旁的字幕" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="视频旁边有同名 .srt / .vtt 时，直接用来翻译，跳过语音识别"
                                           Style="{StaticResource RowDescStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox x:Name="AutoSubtitleCheck" Grid.Column="1" Content="启用"
                                      VerticalAlignment="Center" Click="AutoSubtitle_Changed" />
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <!-- 字幕检查页：翻译过程中检查识别文本，改完可以保存并继续翻译。
                             默认关着，免得导航栏多一项用不到的东西。 -->
                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="检查和编辑字幕" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Style="{StaticResource RowDescStyle}" TextWrapping="Wrap">单个视频翻译完成后会暂停，双语对照检查译文<LineBreak />改完点「保存并继续翻译」，再配音和压制</TextBlock>
                            </StackPanel>
                            <CheckBox x:Name="SubtitleReviewCheck" Grid.Column="1" Content="启用"
                                      VerticalAlignment="Center" Click="SubtitleReview_Changed" />
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="配音语速" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="默认标准语速；每句仍会自动贴合时长"
                                           Style="{StaticResource RowDescStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ctl:GlassSelect x:Name="SpeedBox" Grid.Column="1" MinWidth="220" />
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="YouTube 字幕" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="有创作者字幕就直接拿来翻译，更准也更快"
                                           Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <ctl:GlassSelect x:Name="SubsBox" Grid.Column="1" MinWidth="220" />
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="原声音量" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Style="{StaticResource RowDescStyle}" TextWrapping="Wrap">成片里留一点原声当底噪<LineBreak />0 = 纯中文</TextBlock>
                            </StackPanel>
                            <Grid Grid.Column="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="OrigSlider" Grid.Column="0" Minimum="0" Maximum="100"
                                        StepFrequency="5" ValueChanged="Orig_ValueChanged" />
                                <TextBlock x:Name="OrigText" Grid.Column="1" Text="15%" FontSize="14"
                                           VerticalAlignment="Center" TextAlignment="Right"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="配音怎么读" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="一句话交代语气语速。留空 = 用默认（标准语速）"
                                           Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <TextBox x:Name="StyleBox" Grid.Column="1" PlaceholderText="例如：语速自然，像正常讲解一样清晰。"
                                     LostFocus="Style_LostFocus" />
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <!-- 音色克隆：默认关（声音权 / 深度合成合规，用户 2026-10-13 定） -->
                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="用原说话人的音色" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Style="{StaticResource RowDescStyle}" TextWrapping="Wrap">用原视频里的人声念中文<LineBreak />云端：限时免费，受网络和限流影响，可能忽快忽慢<LineBreak />本机：免费、不联网，速度快、效果好</TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <CheckBox x:Name="CloneCheck" Content="用原视频里的人声念中文"
                                          Click="Clone_Changed" />
                                <Grid ColumnSpacing="8" x:Name="CloneEngineRow">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="克隆引擎" FontSize="13"
                                               VerticalAlignment="Center" Opacity="0.75" />
                                    <ctl:GlassSelect x:Name="CloneEngineBox" Grid.Column="1" MinWidth="300" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <!-- 本地语音克隆（备用）：默认不装，要用再下 -->
                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="本地语音克隆" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="本地语音克隆 · 本机跑，不联网不要 Key · 约 15 GB"
                                           Style="{StaticResource RowDescStyle}" />
                                <TextBlock x:Name="CloneHint" FontSize="12.5" Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Top">
                                <Button x:Name="CloneInstallBtn" Content="下载并启用" Click="CloneInstall_Click" />
                                <Button x:Name="CloneRemoveBtn" Content="删除" Visibility="Collapsed"
                                        Click="CloneRemove_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= 字幕样式 ================= -->
                <Border Style="{StaticResource CardStyle}" Translation="0,0,20"
                        Background="{ThemeResource PanelBrush}"
                        BorderBrush="{ThemeResource PanelStrokeBrush}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="字幕样式" Style="{StaticResource GroupTitleStyle}" />
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <!-- 实时预览：后端用真实 libass 渲一帧，和成片效果一致；点图可放大 -->
                        <StackPanel Padding="16,14" Spacing="6">
                            <Grid>
                                <!-- 固定 16:9，按卡片宽度等比缩放：图片正好铺满，不会留下黑边 -->
                                <Viewbox Stretch="Uniform" MaxHeight="320" HorizontalAlignment="Center">
                                    <Button x:Name="SubPreviewButton" Width="640" Height="360" Padding="0" BorderThickness="0"
                                            Background="Transparent" Click="SubPreview_Click"
                                            ToolTipService.ToolTip="点击放大">
                                        <Border Width="640" Height="360" CornerRadius="12" Background="#10141C">
                                            <Image x:Name="SubPreviewImage" Stretch="Fill" IsHitTestVisible="False" />
                                        </Border>
                                    </Button>
                                </Viewbox>
                                <TextBlock x:Name="SubPreviewHint" Text="调整下面的样式，这里实时预览"
                                           FontSize="13" Opacity="0.55"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ProgressRing x:Name="SubPreviewRing" Width="24" Height="24"
                                              IsActive="False" Visibility="Collapsed"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="点预览图可放大查看" FontSize="12" Opacity="0.55"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <!-- 双语字幕：开了才显示下面两条样式设置（用户 2026-10-21 要求） -->
                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="双语字幕" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Style="{StaticResource RowDescStyle}" TextWrapping="Wrap">原文和中文各占一行<LineBreak />只影响烧进视频的字幕，导出的 .srt 仍是中文</TextBlock>
                            </StackPanel>
                            <CheckBox x:Name="SubBilingualCheck" Grid.Column="1" Content="启用"
                                      VerticalAlignment="Center" Click="SubBilingual_Changed" />
                        </Grid>

                        <StackPanel x:Name="SubBilingualRows" Visibility="Collapsed">
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid Padding="16,12" ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="原文位置" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="原文那一行放在中文上面还是下面"
                                               Style="{StaticResource RowDescStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ctl:GlassSelect x:Name="SubBilingualOrderBox" Grid.Column="1" MinWidth="220" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid Padding="16,12" ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="原文字号" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="相对中文字号的大小，100% = 一样大"
                                               Style="{StaticResource RowDescStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid Grid.Column="1" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SubBilingualScaleSlider" Grid.Column="0"
                                            Minimum="50" Maximum="100" StepFrequency="5"
                                            ValueChanged="SubBilingualScale_ValueChanged" />
                                    <TextBlock x:Name="SubBilingualScaleText" Grid.Column="1" FontSize="14"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="字体" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="默认随包自带；也可以选自己电脑上的字体文件"
                                           Style="{StaticResource RowDescStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock x:Name="SubFontText" Text="思源黑体 Light（随包）" FontSize="14" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="选择字体文件…" Click="PickSubFont_Click" />
                                    <Button x:Name="SubFontResetBtn" Content="恢复默认" Click="ResetSubFont_Click" />
                                </StackPanel>
                                <TextBlock x:Name="SubFontHint" Style="{StaticResource RowDescStyle}"
                                           TextWrapping="Wrap"
                                           Text="支持 .ttf / .otf / .ttc；请使用你有权使用的字体" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="字号" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="太长的行会自动缩小字号，尽量保持一行"
                                           Style="{StaticResource RowDescStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid Grid.Column="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SubSizeSlider" Grid.Column="0" Minimum="24" Maximum="60"
                                        StepFrequency="0.5" ValueChanged="SubSize_ValueChanged" />
                                <TextBlock x:Name="SubSizeText" Grid.Column="1" FontSize="14"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="字间距" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="字与字之间的距离，负数更紧"
                                           Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <Grid Grid.Column="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SubSpacingSlider" Grid.Column="0" Minimum="-5" Maximum="15"
                                        StepFrequency="0.5" ValueChanged="SubSpacing_ValueChanged" />
                                <TextBlock x:Name="SubSpacingText" Grid.Column="1" FontSize="14"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="描边" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="0 = 无描边" Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <Grid Grid.Column="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SubOutlineSlider" Grid.Column="0" Minimum="0" Maximum="5"
                                        StepFrequency="0.1" ValueChanged="SubOutline_ValueChanged" />
                                <TextBlock x:Name="SubOutlineText" Grid.Column="1" FontSize="14"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="描边颜色" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="自动会根据字幕颜色配黑或白"
                                           Style="{StaticResource RowDescStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <CheckBox x:Name="SubOutlineAutoCheck" Content="自动（推荐）"
                                          Click="SubOutlineAuto_Changed" />
                                <Button x:Name="SubOutlineColorButton"
                                        HorizontalAlignment="Left" Padding="10,6"
                                        Visibility="Collapsed">
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <ColorPicker x:Name="SubOutlineColorPicker"
                                                         RequestedTheme="Dark"
                                                         IsAlphaEnabled="False"
                                                         IsColorChannelTextInputVisible="False"
                                                         IsHexInputVisible="True"
                                                         IsMoreButtonVisible="False"
                                                         Orientation="Horizontal"
                                                         ColorChanged="SubOutlineColor_Changed" />
                                        </Flyout>
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border x:Name="SubOutlineColorSwatch" Width="18" Height="18"
                                                CornerRadius="4" Background="Black"
                                                BorderBrush="#40FFFFFF" BorderThickness="1" />
                                        <TextBlock x:Name="SubOutlineColorText" Text="#000000" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="字幕颜色" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="深色会自动配白色描边"
                                           Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <Button x:Name="SubColorButton" Grid.Column="1"
                                    HorizontalAlignment="Left" Padding="10,6">
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <ColorPicker x:Name="SubColorPicker"
                                                     RequestedTheme="Dark"
                                                     IsAlphaEnabled="False"
                                                     IsColorChannelTextInputVisible="False"
                                                     IsHexInputVisible="True"
                                                     IsMoreButtonVisible="False"
                                                     Orientation="Horizontal"
                                                     ColorChanged="SubColor_Changed" />
                                    </Flyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border x:Name="SubColorSwatch" Width="18" Height="18"
                                            CornerRadius="4" Background="White"
                                            BorderBrush="#40FFFFFF" BorderThickness="1" />
                                    <TextBlock x:Name="SubColorText" Text="#FFFFFF" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="底部距离" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="字幕离画面底部多远" Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <Grid Grid.Column="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SubMarginSlider" Grid.Column="0" Minimum="10" Maximum="120"
                                        StepFrequency="1" ValueChanged="SubMargin_ValueChanged" />
                                <TextBlock x:Name="SubMarginText" Grid.Column="1" FontSize="14"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />
                        <Grid Padding="16,12">
                            <Button Content="全部恢复默认" Click="ResetSubtitleStyle_Click"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= 输出 ================= -->
                <Border Style="{StaticResource CardStyle}" Translation="0,0,20"
                        Background="{ThemeResource PanelBrush}"
                        BorderBrush="{ThemeResource PanelStrokeBrush}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="输出" Style="{StaticResource GroupTitleStyle}" />
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="输出目录" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="留空 = 视频旁边的 output\"
                                           Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <Grid Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutDirBox" Grid.Column="0" PlaceholderText="留空 = 视频旁边的 output 文件夹"
                                         MinHeight="44" VerticalContentAlignment="Center"
                                         LostFocus="Field_LostFocus" Tag="output_dir" />
                                <Button Grid.Column="1" Content="选择…" Click="PickOutDir_Click" />
                            </Grid>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <!-- 引擎数据目录：2026-10-16 从「高级（一般不用改）」挪出来的 ——
                             首页撤掉换盘按钮之后，这里是**唯一**的换盘入口，
                             不能藏在写着"一般不用改"的折叠里（首页那行的「去设置」就送到这儿）。 -->
                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="引擎数据目录" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Style="{StaticResource RowDescStyle}" TextWrapping="Wrap">引擎、语音模型和分离模型都放这里，装完约 15 GB（不含语音克隆，那一项在下面「数据目录」）<LineBreak />留空 = 默认位置（新装会跟「数据目录」放在一起；之前装过的保持原来的位置）。点「选择…」换盘会先把数据搬过去（同盘瞬时、跨盘几分钟），搬不动才重新下载</TextBlock>
                            </StackPanel>
                            <Grid Grid.Column="1" RowSpacing="4" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="8"
                                      HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="HomeBox" Grid.Column="0" PlaceholderText="留空 = 默认位置"
                                             MinHeight="44" VerticalContentAlignment="Center"
                                             LostFocus="Field_LostFocus" Tag="finesub_home" />
                                    <Button Grid.Column="1" Content="选择…" Click="PickHome_Click" />
                                </Grid>
                                <TextBlock x:Name="HomeHint" Grid.Row="1" Grid.Column="0" FontSize="12.5" Opacity="0.6"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <!-- 数据目录：语音克隆和各种缓存的统一根目录（2026-10-21 加）。
                             注意它和上面「引擎数据目录」是两回事：那一项只管翻译引擎，
                             这一项管星译自己的数据（语音克隆、配音缓存、缩略图、wheel）。 -->
                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="数据目录" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Style="{StaticResource RowDescStyle}" TextWrapping="Wrap">语音克隆、配音缓存、缩略图都放这里<LineBreak />留空 = 默认位置（新装跟软件放在一起；之前装过的保持原来的位置）。点「选择…」可以换盘</TextBlock>
                            </StackPanel>
                            <Grid Grid.Column="1" RowSpacing="4" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="8"
                                      HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DataHomeBox" Grid.Column="0" IsReadOnly="True"
                                             MinHeight="44" VerticalContentAlignment="Center"
                                             PlaceholderText="留空 = 跟软件放在一起" />
                                    <Button Grid.Column="1" Content="选择…" Click="PickDataHome_Click" />
                                </Grid>
                                <TextBlock x:Name="DataHomeHint" Grid.Row="1" Grid.Column="0" FontSize="12.5" Opacity="0.6"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="翻译完自动打开视频" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="只对单个视频生效，批量翻译不打开"
                                           Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoOpenCheck" Grid.Column="1" Content="翻完就打开成片"
                                      VerticalAlignment="Center" Click="AutoOpen_Changed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= 外观 ================= -->
                <!-- 2026-10-16 从「输出与界面」拆出来：输出（文件放哪）和外观（长什么样）
                     本来就不是一回事，混在一张卡里选项多了看着乱（用户点名） -->
                <Border Style="{StaticResource CardStyle}" Translation="0,0,20"
                        Background="{ThemeResource PanelBrush}"
                        BorderBrush="{ThemeResource PanelStrokeBrush}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource GroupTitleStyle}" />
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="背景壁纸" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock x:Name="WallHint" Text="每次启动换一张；喜欢哪张可以钉住"
                                           Style="{StaticResource RowDescStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <ctl:GlassSelect x:Name="WallBox" Width="240" />
                                <Button x:Name="WallNextBtn" Content="换一张" Click="WallNext_Click" />
                                <Button x:Name="WallPinBtn" Content="收藏这张" Click="WallPin_Click" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <!-- 已收藏的壁纸：折叠起来是「生长菜单」，展开是一排预览图（点一下就用它） -->
                        <Expander x:Name="WallExpander" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Margin="14,6,14,10" IsExpanded="True"
                                  Expanding="WallExpander_Expanding">
                            <Expander.Header>
                                <TextBlock x:Name="WallExpanderHeader" Text="已收藏的壁纸" FontSize="14" />
                            </Expander.Header>
                            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                                          Padding="2,4,2,2">
                                <StackPanel x:Name="WallStrip" Orientation="Horizontal" Spacing="10" MinHeight="92" />
                            </ScrollViewer>
                        </Expander>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="背景亮度" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="0% = 纯深色，100% = 壁纸原样" Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <Grid Grid.Column="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="BgSlider" Grid.Column="0" Minimum="0" Maximum="100"
                                        StepFrequency="5" ValueChanged="BgSlider_ValueChanged" />
                                <TextBlock x:Name="BgText" Grid.Column="1" Text="60%" FontSize="14"
                                           VerticalAlignment="Center" TextAlignment="Right"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="主题色" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="点一下就换" Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                        VerticalAlignment="Center">
                                <StackPanel x:Name="AccentRow" Orientation="Horizontal" Spacing="7"
                                            VerticalAlignment="Center" />
                                <Button x:Name="PaletteButton" Content="调色板" Click="ShowPalette_Click"
                                        Padding="12,5" FontSize="13.5" Margin="6,0,0,0"
                                        ToolTipService.ToolTip="更多颜色（在鼠标左边弹出，点一下就换）" />
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                </Border>

                <!-- ================= 高级 ================= -->
                <Border Style="{StaticResource CardStyle}" Translation="0,0,20"
                        Background="{ThemeResource PanelBrush}"
                        BorderBrush="{ThemeResource PanelStrokeBrush}" Padding="0">
                    <StackPanel>
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  IsExpanded="True" Margin="0,4,0,4">
                            <Expander.Header>
                                <TextBlock Text="高级（一般不用改）" FontSize="15" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="版本与更新" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock x:Name="UpdateText" Text="当前版本 —" Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9">
                                <Button x:Name="UpdateBtn" Content="检查更新" Click="CheckUpdate_Click" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="网络代理" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Style="{StaticResource RowDescStyle}" TextWrapping="Wrap">最好全程开启<LineBreak />检查更新、下载视频、联网查证都要用</TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <Grid ColumnSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ProxyBox" VerticalAlignment="Center"
                                             PlaceholderText="http://127.0.0.1:7897"
                                             LostFocus="Field_LostFocus" Tag="proxy" />
                                    <Button x:Name="ProxyTestBtn" Grid.Column="1" Content="检测"
                                            Click="DetectProxy_Click"
                                            ToolTipService.ToolTip="测一下填的地址通不通；不通就自动找 Windows 系统代理和本机常见端口" />
                                </Grid>
                                <TextBlock x:Name="ProxyHint" Style="{StaticResource RowDescStyle}"
                                           TextWrapping="Wrap"
                                           Text="开了代理软件就保持开启。不知道端口可以留空，会自动使用系统代理并探测本机常见端口。" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="GitHub 加速镜像" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Style="{StaticResource RowDescStyle}" TextWrapping="Wrap">没代理时靠它下引擎组件<LineBreak />auto = 自动挑</TextBlock>
                            </StackPanel>
                            <TextBox x:Name="MirrorBox" Grid.Column="1" PlaceholderText="auto"
                                     LostFocus="Field_LostFocus" Tag="github_mirror" />
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="翻译引擎路径" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="留空 = 自动查找" Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <TextBox x:Name="FinesubBox" Grid.Column="1" PlaceholderText="留空 = 自动查找"
                                     LostFocus="Field_LostFocus" Tag="finesub_exe" />
                        </Grid>
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <!-- 术语学习：默认开（「越用越准」的来源之一，见 builtin_kb.py）。
                             放在「高级」里是因为它偏引擎行为、且会多花一点翻译费用。 -->
                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="术语学习" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Style="{StaticResource RowDescStyle}" TextWrapping="Wrap">翻译时自动把新学到的术语写进词条库，越用越准<LineBreak />会多花一点翻译费用；关掉 = 只读不写</TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                        VerticalAlignment="Center">
                                <CheckBox x:Name="LearnTermsCheck" Content="自动积累术语"
                                          Click="LearnTerms_Changed" />
                                <!-- 2026-10-16 加的：条款里写了「术语会留存在本机」，
                                     那就得让用户**看得到、清得掉** —— 没入口的话条款只能写成
                                     「自己删数据目录里的文件」，那是拿法律文件承认产品缺口。 -->
                                <Button x:Name="KbViewBtn" Content="查看术语库…" Click="ViewKnowledge_Click" />
                            </StackPanel>
                        </Grid>

                        <!-- DeepSeek 联网查证：和上面「引擎 native retrieval」是两个独立开关。
                             只做翻译前的一次搜索，把摘要并进给引擎的背景信息；不需要代理/Gemini。 -->
                        <Border Style="{StaticResource RowDividerStyle}" />
                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DeepSeek 联网查证" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Style="{StaticResource RowDescStyle}" TextWrapping="Wrap">翻译前用 DeepSeek 搜索补充背景资料，不需要代理<LineBreak />会多花一点 DeepSeek 额度；和引擎自带的联网查证互不影响</TextBlock>
                            </StackPanel>
                            <CheckBox x:Name="DeepSeekSearchCheck" Grid.Column="1" Content="启用"
                                      VerticalAlignment="Center" Click="DeepSeekSearch_Changed" />
                        </Grid>
                    </StackPanel>
                        </Expander>
</StackPanel>
                </Border>

                <!-- ================= 遇到问题 ================= -->
                <Border Style="{StaticResource CardStyle}" Translation="0,0,20"
                        Background="{ThemeResource PanelBrush}"
                        BorderBrush="{ThemeResource PanelStrokeBrush}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="遇到问题" Style="{StaticResource GroupTitleStyle}" />
                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Padding="16,12" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="日志与诊断" Style="{StaticResource RowLabelStyle}" />
                                <TextBlock Text="出问题把日志或报告发我"
                                           Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <!-- 「复制日志」2026-10-16 去掉（用户定）：导出诊断报告已经把
                                     日志+环境+自检打包成一个 zip（README 教的也是发它），
                                     旁边还有「打开日志目录」—— 这一排少一个按钮更清爽，
                                     也免得用户只粘半截日志过来（没环境信息没法看）。 -->
                                <Button Content="打开日志目录" Click="OpenLogs_Click" />
                                <Button Content="导出诊断报告" Click="ExportDiag_Click" />
                                <Button Content="用户协议" Click="Terms_Click" />
                                <Button x:Name="ThanksBtn" Content="感谢" Click="Licenses_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="设置只存本机，不会上传"
                           FontSize="12.5" Margin="4,4,0,10"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </ScrollView>

        <!-- 空白点击的焦点接收器：它不在 ScrollView 里，聚焦它不会让页面滚动。
             位置/尺寸都是 1px 且不参与命中测试，只用于代码里 Focus()。 -->
        <Button x:Name="FocusSink" Grid.Row="1" Width="1" Height="1"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Opacity="0" IsHitTestVisible="False"
                IsTabStop="True" TabIndex="-1" UseSystemFocusVisuals="False"
                AutomationProperties.AutomationId="FocusSink"
                AutomationProperties.AccessibilityView="Raw" />
    </Grid>
</Page>
